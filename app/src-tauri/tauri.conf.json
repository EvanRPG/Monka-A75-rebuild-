{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A75 Driver",
  "version": "1.0.0",
  "identifier": "io.github.evanrpg.monka-a75",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A75 驱动",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "EvanRPG",
    "homepage": "https://github.com/EvanRPG/Monka-A75-rebuild-",
    "copyright": "Copyright (C) 2026 EvanRPG. Based on sharkfin, Copyright (C) JR Lanteigne",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Unofficial driver for the Monka A75 keyboard (based on sharkfin)",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-sharkfin.rules": "../../packaging/70-sharkfin.rules",
          "/usr/share/doc/sharkfin/copyright": "../../LICENSE",
          "/usr/share/doc/sharkfin/THIRD-PARTY-NOTICES.md": "../../THIRD-PARTY-NOTICES.md",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-sharkfin.rules": "../../packaging/70-sharkfin.rules",
          "/usr/share/doc/sharkfin/copyright": "../../LICENSE",
          "/usr/share/doc/sharkfin/THIRD-PARTY-NOTICES.md": "../../THIRD-PARTY-NOTICES.md",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.metainfo.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml",
          "/usr/share/metainfo/com.getsharkfin.sharkfin.appdata.xml": "../../packaging/com.getsharkfin.sharkfin.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "A75Driver"
}
